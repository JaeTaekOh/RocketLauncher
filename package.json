{
  "name": "rocket-launcher",
  "version": "0.2.4",
  "private": true,
  "description": "Rocket Launcher \u2014 a free web tool that takes your app to launch; you just decide",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "sample": "python3 tools/build_sample.py",
    "shots": "/workspace/venv-pw/bin/python tools/walkthrough.py",
    "mcp": "node mcp/server.mjs",
    "mcp:http": "node mcp/server.mjs --http",
    "mcp:test": "cd mcp && npm test",
    "sim": "cd mcp && npm run -s sim",
    "plugin:build": "bash tools/build_plugin.sh",
    "pages": "bash tools/build_pages.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaeTaekOh/rocketlauncher.git"
  },
  "bugs": {
    "url": "https://github.com/JaeTaekOh/rocketlauncher/issues"
  },
  "homepage": "https://jaetaekoh.github.io/RocketLauncher/",
  "author": "Prezentree"
}
